# Anthropic
ANTHROPIC_API_KEY=
# Only needed if your API key is "identity-linked" (newer Anthropic accounts).
# Find it at console.anthropic.com under Settings -> Workspaces. Looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Database — set by Railway in production. Leave blank locally to use PGlite.
DATABASE_URL=

# Web chat
SESSION_SECRET=change-me-to-a-long-random-string

# Users. Either set WEB_PASSWORD for a single user (name defaults to "Colt",
# override with WEB_USER_NAME / WEB_USER_PERSONA)...
WEB_PASSWORD=
WEB_USER_NAME=Colt
WEB_USER_PERSONA=

# ...or set JARVIS_USERS to a JSON array for multiple people, each with their
# own password and separate memory. `persona` and `telegramId` are optional.
# JARVIS_USERS=[{"name":"Colt","password":"..."},{"name":"Rich","password":"...","persona":"high-ticket construction sales specialist","telegramId":"123456789"}]
JARVIS_USERS=

# Telegram
TELEGRAM_BOT_TOKEN=
# For the single-user fallback only; with JARVIS_USERS, put telegramId in the JSON.
OWNER_TELEGRAM_ID=

# SMS (Twilio). Set all three plus a `phone` on each user (in JARVIS_USERS, or
# OWNER_PHONE for the single-user fallback) to enable texting.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=
# Set the number's inbound SMS webhook (in the Twilio console) to:
#   {PUBLIC_URL}/twilio/sms

# Behaviour
TZ=America/Denver
WORKSPACE_DIR=./workspace
PUBLIC_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
