# Jarvis local config. Copy to `.env`. Jarvis runs on your Mac.
#
# Auth: there is NO ANTHROPIC_API_KEY here on purpose. The Claude Agent SDK
# spawns the `claude` CLI, which uses your claude.ai login (Claude Pro/Max
# subscription) — no per-message API charge. Just make sure `claude` is
# installed and you're logged in. Set ANTHROPIC_API_KEY only if you
# specifically want pay-per-token API billing instead.

SESSION_SECRET=change-me-to-a-long-random-string

# Users. Either a JSON file (recommended — handles quotes/# in personas):
JARVIS_USERS_FILE=jarvis-users.json
# ...or JARVIS_USERS inline JSON, or a single WEB_PASSWORD:
# JARVIS_USERS=[{"name":"Colt","password":"..."}]
# WEB_PASSWORD=
# WEB_USER_NAME=Colt

# Telegram — works from anywhere (the bot polls out; no public URL needed).
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Google (Gmail + Calendar). OAuth client (type: Web application) with the
# redirect URI http://localhost:3000/auth/google/callback. Then click
# "Connect Google" in the console Settings tab.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Behaviour
TZ=America/New_York
# claude-sonnet-5 (default), or claude-haiku-4-5 to use less of your plan's quota
JARVIS_MODEL=claude-sonnet-5
PORT=3000
PUBLIC_URL=http://localhost:3000

# Cloud Postgres (optional). Leave blank to use a local file at
# workspace/dev.pglite.
# DATABASE_URL=
